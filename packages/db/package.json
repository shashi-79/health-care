{
  "name": "@rhc/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf .turbo dist",
    "typecheck": "tsc -p tsconfig.jsonc",
    "worker": "ts-node --require tsconfig-paths/register src/worker.ts"
  },
  "dependencies": {
    "bullmq": "^5.7.8",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@types/pg": "^8.11.6",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
