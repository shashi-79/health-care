{
  "extends": "../../tsconfig.base.jsonc",
  "compilerOptions": {
    "allowJs": false,
    "incremental": true,
    "outDir": "dist",
    "noEmitOnError": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "rootDir": "../.."
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
