{
  "name": "rural-health-copilot",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @rhc/web -- --hostname 0.0.0.0",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspace @rhc/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "5.4.5",
    "vitest": "4.1.4"
  },
  "overrides": {
    "eslint": "9.39.1"
  }
}
