{
  "name": "rural-health-copilot",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @rhc/web",
    "worker": "npm run worker --workspace @rhc/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspace @rhc/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "echo \"Run migrations with your chosen tool (Drizzle/Prisma).\""
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.4"
  },
  "overrides": {
    "eslint": "9.39.1"
  }
}
