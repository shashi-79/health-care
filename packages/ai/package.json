{
  "name": "@rhc/ai",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@google/genai": "^1.50.1",
    "openai": "^6.34.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
